<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing phones home and nothing leaves the device automatically (plan §12).
  Backup is the app's own explicit export (§14), not Android auto-backup.
-->
<data-extraction-rules>
    <cloud-backup><exclude domain="root" /></cloud-backup>
    <device-transfer><exclude domain="root" /></device-transfer>
</data-extraction-rules>
